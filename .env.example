# 법제처 OPEN API 인증키 — 가입 이메일의 ID 부분
LAW_API_OC=your_email_id
LAW_API_BASE=https://www.law.go.kr/DRF

OLLAMA_BASE_URL=http://localhost:11434

# Modelfile 로 생성한 태그. 베이스 태그(qwen3.5:4b)를 넣으면
# num_ctx 가 262144 로 돌아가 8GB VRAM 에서 CPU 오프로드가 발생한다.
#   ollama create govrule-4b -f app/llm/Modelfile.govrule
LLM_MODEL=govrule-4b
